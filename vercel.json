{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_OPTIONS": "--max_old_space_size=4096"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "node-20.x"
    }
  },
  "routes": [
    {
      "src": "^/(?!.*\\.)(?!api).*$",
      "dest": "/index.html"
    }
  ]
}
